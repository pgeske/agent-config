#!/usr/bin/env bash
set -euo pipefail

DEFAULT_DONE_TTL_SECONDS="${PI_TMUX_NOTIFY_DONE_TTL_SECONDS:-8}"
DEFAULT_VIEWED_TTL_SECONDS="${PI_TMUX_NOTIFY_VIEWED_TTL_SECONDS:-4}"
NOTIFY_FORMAT='#{?@pi_notify_label, #{@pi_notify_label},}'

usage() {
  cat <<'EOF'
Usage: tmux-pi-notify <command> [args]

Commands:
  install                 Install tmux status/chooser rendering and viewed hook
  set <state> <label>     Set notification on the current tmux window
  viewed [target]         Schedule clear for a viewed non-running notification
  clear [target]          Clear notification on target/current window
  clear-if-id <target> <id>
                          Clear only when the notification id still matches
  clear-if-active <target> <id>
                          Clear matching notification only if target is visible
EOF
}

have_tmux() {
  command -v tmux >/dev/null 2>&1 && tmux display-message -p '#{session_name}' >/dev/null 2>&1
}

current_window_id() {
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux display-message -p -t "$TMUX_PANE" '#{window_id}'
  else
    selected_window_id
  fi
}

selected_window_id() {
  tmux display-message -p '#{window_id}'
}

window_option() {
  local target="$1"
  local option="$2"
  tmux show-window-option -t "$target" -v "$option" 2>/dev/null || true
}

set_window_option() {
  local target="$1"
  local option="$2"
  local value="$3"
  tmux set-window-option -t "$target" -q "$option" "$value"
}

unset_window_option() {
  local target="$1"
  local option="$2"
  tmux set-window-option -t "$target" -qu "$option" 2>/dev/null || true
}

is_window_active() {
  local target="$1"
  local target_id target_session client client_id
  target_id="$(tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null || true)"
  target_session="$(tmux display-message -p -t "$target" '#{session_name}' 2>/dev/null || true)"

  [ -n "$target_id" ] || return 1

  if [ -n "$target_session" ]; then
    while IFS= read -r client; do
      [ -n "$client" ] || continue
      client_id="$(tmux display-message -p -c "$client" '#{window_id}' 2>/dev/null || true)"
      if [ "$client_id" = "$target_id" ]; then
        return 0
      fi
    done <<EOF_CLIENTS
$(tmux list-clients -t "$target_session" -F '#{client_name}' 2>/dev/null || true)
EOF_CLIENTS
  fi

  [ "$(tmux display-message -p -t "$target" '#{window_active}' 2>/dev/null || echo 0)" = "1" ]
}

shell_quote() {
  printf '%q' "$1"
}

base_window_format() {
  local option="$1"
  case "$option" in
    window-status-current-format) printf '#I #W' ;;
    *) printf '#I #W' ;;
  esac
}

append_notify_format() {
  local option="$1"
  local current
  current="$(tmux show-window-option -gv "$option" 2>/dev/null || true)"

  # If a previous install ran while the theme/plugin format was empty, the
  # notification snippet could become the entire format. Repair that case rather
  # than preserving a status bar that renders only icons.
  if [ -z "$current" ] || [ "$current" = "$NOTIFY_FORMAT" ]; then
    current="$(base_window_format "$option")"
  fi

  if [[ "$current" != *'@pi_notify_label'* ]]; then
    tmux set-window-option -gq "$option" "${current}${NOTIFY_FORMAT}"
  else
    tmux set-window-option -gq "$option" "$current"
  fi
}

install_tmux_integration() {
  have_tmux || exit 0

  append_notify_format window-status-format
  append_notify_format window-status-current-format

  # Keep the user's compact window chooser, but include Pi notification labels.
  tmux bind-key k choose-tree -Zw -F '#{window_name}#{?@pi_notify_label, #{@pi_notify_label},}'

  local script_path
  script_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  local quoted_script
  quoted_script="$(shell_quote "$script_path")"

  # Use fixed hook array indices so re-running install is idempotent and does
  # not duplicate hooks. `after-select-window` catches explicit select-window
  # commands; `session-window-changed` catches client/window changes such as
  # switching via the status bar or chooser.
  tmux set-hook -g 'after-select-window[99]' "run-shell -b '$quoted_script viewed #{window_id}'" >/dev/null
  tmux set-hook -g 'session-window-changed[99]' "run-shell -b '$quoted_script viewed #{window_id}'" >/dev/null

  # Also apply the viewed policy to the currently selected window on install.
  # This cleans up stale done/failed notifications from older helper versions
  # that did not schedule clears correctly.
  mark_viewed "$(selected_window_id)" || true
}

clear_notification() {
  local target="${1:-$(current_window_id)}"
  unset_window_option "$target" @pi_notify_label
  unset_window_option "$target" @pi_notify_state
  unset_window_option "$target" @pi_notify_id
  unset_window_option "$target" @pi_notify_set_at
}

clear_if_id() {
  local target="$1"
  local expected_id="$2"
  local current_id
  current_id="$(window_option "$target" @pi_notify_id)"
  if [ -n "$expected_id" ] && [ "$current_id" = "$expected_id" ]; then
    clear_notification "$target"
  fi
}

clear_if_active() {
  local target="$1"
  local expected_id="$2"
  local current_id
  current_id="$(window_option "$target" @pi_notify_id)"
  if [ -n "$expected_id" ] && [ "$current_id" = "$expected_id" ] && is_window_active "$target"; then
    clear_notification "$target"
  fi
}

schedule_clear() {
  local target="$1"
  local id="$2"
  local delay_seconds="$3"
  local clear_command="${4:-clear-if-id}"
  local script_path
  script_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  local quoted_script quoted_target quoted_id quoted_delay quoted_command
  quoted_script="$(shell_quote "$script_path")"
  quoted_target="$(shell_quote "$target")"
  quoted_id="$(shell_quote "$id")"
  quoted_delay="$(shell_quote "$delay_seconds")"
  quoted_command="$(shell_quote "$clear_command")"

  # Let the tmux server own the delayed clear. This is more reliable than
  # leaving an orphaned background shell from a Pi/node child process or from a
  # tmux hook invocation.
  tmux run-shell -b "sleep $quoted_delay; $quoted_script $quoted_command $quoted_target $quoted_id"
}

set_notification() {
  local state="$1"
  local label="$2"
  local target
  target="$(current_window_id)"

  local id
  id="${state}-$(date +%s)-$RANDOM-$$"

  set_window_option "$target" @pi_notify_state "$state"
  set_window_option "$target" @pi_notify_label "$label"
  set_window_option "$target" @pi_notify_id "$id"
  set_window_option "$target" @pi_notify_set_at "$(date +%s)"

  if [ "$state" != "running" ]; then
    schedule_clear "$target" "$id" "$DEFAULT_DONE_TTL_SECONDS" clear-if-active
  fi
}

mark_viewed() {
  local target="${1:-$(selected_window_id)}"
  local state id
  state="$(window_option "$target" @pi_notify_state)"
  id="$(window_option "$target" @pi_notify_id)"

  [ -n "$id" ] || exit 0
  [ "$state" != "running" ] || exit 0

  schedule_clear "$target" "$id" "$DEFAULT_VIEWED_TTL_SECONDS"
}

main() {
  local cmd="${1:-}"
  if [ -z "$cmd" ]; then
    usage >&2
    exit 2
  fi

  case "$cmd" in
    install)
      install_tmux_integration
      ;;
    set)
      if ! have_tmux; then
        exit 0
      fi
      if [ "$#" -lt 3 ]; then
        usage >&2
        exit 2
      fi
      set_notification "$2" "$3"
      ;;
    viewed)
      have_tmux || exit 0
      mark_viewed "${2:-}"
      ;;
    clear)
      have_tmux || exit 0
      clear_notification "${2:-}"
      ;;
    clear-if-id)
      have_tmux || exit 0
      if [ "$#" -lt 3 ]; then
        usage >&2
        exit 2
      fi
      clear_if_id "$2" "$3"
      ;;
    clear-if-active)
      have_tmux || exit 0
      if [ "$#" -lt 3 ]; then
        usage >&2
        exit 2
      fi
      clear_if_active "$2" "$3"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
