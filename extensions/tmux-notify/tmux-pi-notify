#!/usr/bin/env bash
set -euo pipefail

DEFAULT_DONE_TTL_SECONDS="${PI_TMUX_NOTIFY_DONE_TTL_SECONDS:-8}"
DEFAULT_VIEWED_TTL_SECONDS="${PI_TMUX_NOTIFY_VIEWED_TTL_SECONDS:-4}"
NOTIFY_FORMAT='#{?@pi_notify_label, #{@pi_notify_label},}'

usage() {
  cat <<'EOF'
Usage: tmux-pi-notify <command> [args]

Commands:
  install                 Install tmux status/chooser rendering and viewed hook
  set <state> <label>     Set notification for the current tmux pane/window
  viewed [target]         Schedule clear for a viewed non-running notification
  clear [target]          Clear notification on target/current window
  clear-if-id <target> <id>
                          Clear only the matching notification id
  clear-if-active <target> <id>
                          Clear matching notification only if target is visible
EOF
}

have_tmux() {
  command -v tmux >/dev/null 2>&1 && tmux display-message -p '#{session_name}' >/dev/null 2>&1
}

current_pane_id() {
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux display-message -p -t "$TMUX_PANE" '#{pane_id}'
  else
    tmux display-message -p '#{pane_id}'
  fi
}

current_window_id() {
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux display-message -p -t "$TMUX_PANE" '#{window_id}'
  else
    selected_window_id
  fi
}

selected_window_id() {
  tmux display-message -p '#{window_id}'
}

window_option() {
  local target="$1"
  local option="$2"
  tmux show-window-option -t "$target" -v "$option" 2>/dev/null || true
}

set_window_option() {
  local target="$1"
  local option="$2"
  local value="$3"
  tmux set-window-option -t "$target" -q "$option" "$value"
}

unset_window_option() {
  local target="$1"
  local option="$2"
  tmux set-window-option -t "$target" -qu "$option" 2>/dev/null || true
}

pane_option() {
  local target="$1"
  local option="$2"
  tmux show-options -p -t "$target" -v "$option" 2>/dev/null || true
}

set_pane_option() {
  local target="$1"
  local option="$2"
  local value="$3"
  tmux set-option -p -t "$target" -q "$option" "$value"
}

unset_pane_option() {
  local target="$1"
  local option="$2"
  tmux set-option -p -t "$target" -qu "$option" 2>/dev/null || true
}

clear_pane_notification() {
  local target="$1"
  # Current @pi_notify_pane_* names plus the legacy @pi_notify_* names used
  # before pane state was namespaced: format lookups walk pane first, so a
  # stale legacy value on a pane would shadow the window aggregate in the tab.
  unset_pane_option "$target" @pi_notify_pane_label
  unset_pane_option "$target" @pi_notify_pane_state
  unset_pane_option "$target" @pi_notify_pane_id
  unset_pane_option "$target" @pi_notify_pane_set_at
  unset_pane_option "$target" @pi_notify_label
  unset_pane_option "$target" @pi_notify_state
  unset_pane_option "$target" @pi_notify_id
  unset_pane_option "$target" @pi_notify_set_at
}

is_window_active() {
  local target="$1"
  local target_id target_session client client_id
  target_id="$(tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null || true)"
  target_session="$(tmux display-message -p -t "$target" '#{session_name}' 2>/dev/null || true)"

  [ -n "$target_id" ] || return 1

  if [ -n "$target_session" ]; then
    while IFS= read -r client; do
      [ -n "$client" ] || continue
      client_id="$(tmux display-message -p -c "$client" '#{window_id}' 2>/dev/null || true)"
      if [ "$client_id" = "$target_id" ]; then
        return 0
      fi
    done <<EOF_CLIENTS
$(tmux list-clients -t "$target_session" -F '#{client_name}' 2>/dev/null || true)
EOF_CLIENTS
  fi

  [ "$(tmux display-message -p -t "$target" '#{window_active}' 2>/dev/null || echo 0)" = "1" ]
}

shell_quote() {
  printf '%q' "$1"
}

base_window_format() {
  local option="$1"
  case "$option" in
    window-status-current-format) printf '#I #W' ;;
    *) printf '#I #W' ;;
  esac
}

append_notify_format() {
  local option="$1"
  local current
  current="$(tmux show-window-option -gv "$option" 2>/dev/null || true)"

  # If a previous install ran while the theme/plugin format was empty, the
  # notification snippet could become the entire format. Repair that case rather
  # than preserving a status bar that renders only icons.
  if [ -z "$current" ] || [ "$current" = "$NOTIFY_FORMAT" ]; then
    current="$(base_window_format "$option")"
  fi

  if [[ "$current" != *'@pi_notify_label'* ]]; then
    tmux set-window-option -gq "$option" "${current}${NOTIFY_FORMAT}"
  else
    tmux set-window-option -gq "$option" "$current"
  fi
}

install_tmux_integration() {
  have_tmux || exit 0

  append_notify_format window-status-format
  append_notify_format window-status-current-format

  # Per-pane state uses @pi_notify_pane_* names. Format lookups resolve pane
  # scope before window scope, so pane values stored under the same names as
  # the window aggregate (the legacy @pi_notify_* names) shadowed the tab with
  # the active pane's state instead of the running-wins aggregate. Sweep the
  # legacy pane options everywhere so old values stop shadowing immediately.
  sweep_legacy_pane_options

  # Keep the user's compact window chooser, but include Pi notification labels.
  tmux bind-key k choose-tree -Zw -F '#{window_name}#{?@pi_notify_label, #{@pi_notify_label},}'

  local script_path
  script_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  local quoted_script
  quoted_script="$(shell_quote "$script_path")"

  # Use fixed hook array indices so re-running install is idempotent and does
  # not duplicate hooks. `after-select-window` catches explicit select-window
  # commands; `session-window-changed` catches client/window changes such as
  # switching via the status bar or chooser.
  tmux set-hook -g 'after-select-window[99]' "run-shell -b '$quoted_script viewed #{window_id}'" >/dev/null
  tmux set-hook -g 'session-window-changed[99]' "run-shell -b '$quoted_script viewed #{window_id}'" >/dev/null

  # Also apply the viewed policy to the currently selected window on install.
  # This cleans up stale done notifications from older helper versions that did
  # not schedule clears correctly.
  mark_viewed "$(selected_window_id)" || true
}

clear_window_options() {
  local target="$1"
  unset_window_option "$target" @pi_notify_label
  unset_window_option "$target" @pi_notify_state
  unset_window_option "$target" @pi_notify_id
  unset_window_option "$target" @pi_notify_set_at
}

sweep_legacy_pane_options() {
  local window pane
  while IFS= read -r window; do
    [ -n "$window" ] || continue
    while IFS= read -r pane; do
      [ -n "$pane" ] || continue
      unset_pane_option "$pane" @pi_notify_state
      unset_pane_option "$pane" @pi_notify_label
      unset_pane_option "$pane" @pi_notify_id
      unset_pane_option "$pane" @pi_notify_set_at
    done <<EOF_PANES
$(tmux list-panes -t "$window" -F '#{pane_id}' 2>/dev/null || true)
EOF_PANES
  done <<EOF_WINDOWS
$(tmux list-windows -a -F '#{window_id}' 2>/dev/null || true)
EOF_WINDOWS
}

aggregate_window_notification() {
  local target="$1"
  local prefer_id="${2:-}"
  local pane state label id set_at take
  local best_state=""
  local best_label=""
  local best_id=""
  local best_set_at="0"

  while IFS= read -r pane; do
    [ -n "$pane" ] || continue
    state="$(pane_option "$pane" @pi_notify_pane_state)"
    # Eligibility is state-based: also requiring a non-empty id would hide a
    # pane whose options were only partially written or read during a tmux
    # hiccup, letting a stale done marker win over a live running pane.
    [ -n "$state" ] || continue
    label="$(pane_option "$pane" @pi_notify_pane_label)"
    id="$(pane_option "$pane" @pi_notify_pane_id)"
    set_at="$(pane_option "$pane" @pi_notify_pane_set_at)"
    set_at="${set_at:-0}"

    if [ "$state" = "running" ]; then
      # Running always wins over done. Prefer the newest running pane's id so
      # delayed clears from older done panes cannot affect the aggregate marker.
      if [ "$best_state" != "running" ] || [ "$set_at" -ge "$best_set_at" ]; then
        best_state="$state"
        best_label="$label"
        best_id="$id"
        best_set_at="$set_at"
      fi
    elif [ "$state" = "done" ] && [ "$best_state" != "running" ]; then
      take=0
      if [ -z "$best_id" ]; then
        take=1
      elif [ "$set_at" -gt "$best_set_at" ]; then
        take=1
      elif [ "$set_at" = "$best_set_at" ] && { [ "$id" = "$prefer_id" ] || [ -z "$prefer_id" ]; }; then
        # Same-second tie: the caller's just-completed pane becomes the visible
        # marker; without a preference the last pane read wins.
        take=1
      fi
      if [ "$take" = "1" ]; then
        best_state="$state"
        best_label="$label"
        best_id="$id"
        best_set_at="$set_at"
      fi
    fi
  done <<EOF_PANES
$(tmux list-panes -t "$target" -F '#{pane_id}' 2>/dev/null || true)
EOF_PANES

  if [ -n "$best_state" ]; then
    set_window_option "$target" @pi_notify_state "$best_state"
    set_window_option "$target" @pi_notify_label "$best_label"
    set_window_option "$target" @pi_notify_id "$best_id"
    set_window_option "$target" @pi_notify_set_at "$best_set_at"
  else
    clear_window_options "$target"
  fi
}

clear_notification() {
  local target="${1:-$(current_window_id)}"
  local pane

  while IFS= read -r pane; do
    [ -n "$pane" ] || continue
    # Clearing dismisses notifications; a running pane's marker is live agent
    # state, not a dismissible notification.
    if [ "$(pane_option "$pane" @pi_notify_pane_state)" != "running" ]; then
      clear_pane_notification "$pane"
    fi
  done <<EOF_PANES
$(tmux list-panes -t "$target" -F '#{pane_id}' 2>/dev/null || true)
EOF_PANES

  # Re-aggregate instead of blindly clearing the window: with a running pane
  # the marker must survive, and with none left the aggregate clears it.
  aggregate_window_notification "$target"
}

clear_matching_notification() {
  local target="$1"
  local expected_id="$2"
  local pane id
  local cleared=0

  while IFS= read -r pane; do
    [ -n "$pane" ] || continue
    id="$(pane_option "$pane" @pi_notify_pane_id)"
    if [ -n "$expected_id" ] && [ "$id" = "$expected_id" ]; then
      # State is written before id by set_notification, so reading it after the
      # id sees the newest truth: a pane that moved on to running is live agent
      # state, and a stale timer must never erase it.
      if [ "$(pane_option "$pane" @pi_notify_pane_state)" != "running" ]; then
        clear_pane_notification "$pane"
        cleared=1
      fi
    fi
  done <<EOF_PANES
$(tmux list-panes -t "$target" -F '#{pane_id}' 2>/dev/null || true)
EOF_PANES

  # Compatibility with older window-only state: clear the window if no pane owns
  # the matching id but the aggregate id still matches.
  if [ "$cleared" = "0" ] && [ "$(window_option "$target" @pi_notify_id)" = "$expected_id" ]; then
    clear_window_options "$target"
  fi

  aggregate_window_notification "$target"
}

clear_if_id() {
  local target="$1"
  local expected_id="$2"
  clear_matching_notification "$target" "$expected_id"
}

clear_if_active() {
  local target="$1"
  local expected_id="$2"
  if [ -n "$expected_id" ] && is_window_active "$target"; then
    clear_matching_notification "$target" "$expected_id"
  fi
}

schedule_clear() {
  local target="$1"
  local id="$2"
  local delay_seconds="$3"
  local clear_command="${4:-clear-if-id}"
  local script_path
  script_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  local quoted_script quoted_target quoted_id quoted_delay quoted_command
  quoted_script="$(shell_quote "$script_path")"
  quoted_target="$(shell_quote "$target")"
  quoted_id="$(shell_quote "$id")"
  quoted_delay="$(shell_quote "$delay_seconds")"
  quoted_command="$(shell_quote "$clear_command")"

  # Let the tmux server own the delayed clear. This is more reliable than
  # leaving an orphaned background shell from a Pi/node child process or from a
  # tmux hook invocation.
  tmux run-shell -b "sleep $quoted_delay; $quoted_script $quoted_command $quoted_target $quoted_id"
}

set_notification() {
  local state="$1"
  local label="$2"
  local target pane
  target="$(current_window_id)"
  pane="$(current_pane_id)"

  local id set_at
  set_at="$(date +%s)"
  id="${state}-${set_at}-$RANDOM-$$"

  set_pane_option "$pane" @pi_notify_pane_state "$state"
  set_pane_option "$pane" @pi_notify_pane_label "$label"
  set_pane_option "$pane" @pi_notify_pane_id "$id"
  set_pane_option "$pane" @pi_notify_pane_set_at "$set_at"

  aggregate_window_notification "$target" "$id"

  # Second pass: a concurrent pane write (another pane's set) that landed
  # between the first pass's reads must not leave a stale winner published.
  sleep 0.05
  aggregate_window_notification "$target" "$id"

  # The same-second done tie-break is handled by prefer_id above. It must stay
  # part of the aggregate: a post-aggregate done override reads the window and
  # then blindly rewrites it, so a concurrent writer (or a transient empty
  # read) between the two steps publishes stale done over a live running pane.
  # Running is the invariant the tab must always reflect, so if even two
  # aggregates failed to publish running while this pane is running, force it:
  # this pane's options were just written successfully, making running the
  # freshest truth available.
  if [ "$state" = "running" ] && [ "$(window_option "$target" @pi_notify_state)" != "running" ]; then
    set_window_option "$target" @pi_notify_state "$state"
    set_window_option "$target" @pi_notify_label "$label"
    set_window_option "$target" @pi_notify_id "$id"
    set_window_option "$target" @pi_notify_set_at "$set_at"
  fi

  if [ "$state" != "running" ]; then
    schedule_clear "$target" "$id" "$DEFAULT_DONE_TTL_SECONDS" clear-if-active
  fi
}

mark_viewed() {
  local target="${1:-$(selected_window_id)}"
  # Read the window-scope options in a single tmux call. A format-var read
  # would resolve pane scope first, and two separate reads could straddle a
  # concurrent aggregate, letting a fresh running id slip past the done-state
  # guard and scheduling a clear that wipes a live running pane.
  local dump state id
  dump="$(tmux show-window-option -t "$target" 2>/dev/null || true)"
  state="$(awk '$1 == "@pi_notify_state" { print $2 }' <<<"$dump")"
  id="$(awk '$1 == "@pi_notify_id" { print $2 }' <<<"$dump")"

  [ -n "$id" ] || exit 0
  [ "$state" != "running" ] || exit 0

  schedule_clear "$target" "$id" "$DEFAULT_VIEWED_TTL_SECONDS"
}

main() {
  local cmd="${1:-}"
  if [ -z "$cmd" ]; then
    usage >&2
    exit 2
  fi

  case "$cmd" in
    install)
      install_tmux_integration
      ;;
    set)
      if ! have_tmux; then
        exit 0
      fi
      if [ "$#" -lt 3 ]; then
        usage >&2
        exit 2
      fi
      set_notification "$2" "$3"
      ;;
    viewed)
      have_tmux || exit 0
      mark_viewed "${2:-}"
      ;;
    clear)
      have_tmux || exit 0
      clear_notification "${2:-}"
      ;;
    clear-if-id)
      have_tmux || exit 0
      if [ "$#" -lt 3 ]; then
        usage >&2
        exit 2
      fi
      clear_if_id "$2" "$3"
      ;;
    clear-if-active)
      have_tmux || exit 0
      if [ "$#" -lt 3 ]; then
        usage >&2
        exit 2
      fi
      clear_if_active "$2" "$3"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
