{
  "settings": {
    "mcpFooterStatus": "off"
  },
  "mcpServers": {
    "mac-computer-use": {
      "command": "node",
      "args": [
        "node_modules/@pgeske/mac-computer-use-mcp/dist/cli.js"
      ],
      "cwd": "${HOME}/agent-config",
      "lifecycle": "lazy-keep-alive",
      "requestTimeoutMs": 180000
    },
    "peekaboo": {
      "disabled": true,
      "command": "peekaboo",
      "args": ["mcp", "--no-remote"],
      "lifecycle": "lazy-keep-alive",
      "requestTimeoutMs": 120000
    }
  }
}
