#!/usr/bin/env bash
set -euo pipefail

# Keep optional private CA trust scoped to OMP, not every shell process.
ca_file="${XDG_CONFIG_HOME:-$HOME/.config}/omp/ca.pem"
if [[ -z "${NODE_EXTRA_CA_CERTS:-}" && -f "$ca_file" ]]; then
  export NODE_EXTRA_CA_CERTS="$ca_file"
fi

# The shared launcher wraps the Homebrew installation on macOS. Machines without
# Homebrew (Linux, WSL) use the official installer pointed at a data directory,
# since this launcher occupies ~/.local/bin/omp. An explicit binary overrides both.
if [[ -n "${OMP_BINARY:-}" ]]; then
  binary="$OMP_BINARY"
elif command -v brew >/dev/null 2>&1; then
  binary="$(brew --prefix omp)/bin/omp"
else
  binary="${XDG_DATA_HOME:-$HOME/.local/share}/omp/bin/omp"
fi
exec "$binary" "$@"
