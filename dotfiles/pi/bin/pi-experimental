#!/bin/sh
set -eu

experimental_root="$HOME/.pi/experimental"
checkout="${PI_EXPERIMENTAL_ROOT:-$(cat "$experimental_root/current" 2>/dev/null || true)}"
if [ -z "$checkout" ]; then
  echo "Experimental Pi pin not found. Run ~/agent-config/bootstrap.sh." >&2
  exit 1
fi
case "$checkout" in
  /*) ;;
  *) checkout="$experimental_root/$checkout" ;;
esac
cli="$checkout/packages/coding-agent/dist/cli.js"

if [ ! -f "$cli" ]; then
  echo "Experimental Pi is not built at $checkout. Run ~/agent-config/bootstrap.sh." >&2
  exit 1
fi

node_bin="${PI_EXPERIMENTAL_NODE:-$(command -v node || true)}"
if [ -z "$node_bin" ]; then
  echo "Node.js is required to run experimental Pi." >&2
  exit 1
fi

exec "$node_bin" "$cli" "$@"
